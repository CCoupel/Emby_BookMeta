# Répertoire privé — kubeconfig, sauvegardes de manifestes, clés
private/

# Build outputs
bin/
obj/
dist/
*.dll
*.pdb
*.user

# SDK Emby — committé pour la CI (nécessaire au build sans installation Emby)
!libs/
!libs/*.dll

# IDE / OS
.vs/
.idea/
*.suo
.DS_Store
Thumbs.db
*.nupkg
packages/

# --- Claude Code template (init-project) ---
TEMPLATE_claude/
.claude/commands/*.md
.claude/commands/*.template.md
.claude/agents/*.template.md
.claude/commands/context/*.template.md
.claude/agents/context/*.template.md
.claude/skills/milestone-panel/
.claude/agents/environments/*.template.md
.claude/agents/environments/*.env
!.claude/agents/environments/*.env.example
.env
!.env.example
MARKETING/
_work/
.claude/workflow/
.claude/worktrees/
build/

# Etat d'orchestration local
.claude/workflow-state.json
.claude/workflow/
